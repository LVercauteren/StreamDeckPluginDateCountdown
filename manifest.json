        }
      ]
    },
    {
      "Name": "Hours",
      "UUID": "com.lvercauteren.datecountdown.hours",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "Encoder": {
        "layout": "countdown.json"
      },
      "States": [
        {
          "Image": "imgs/action"
        }
      ]
    },
    {
      "Name": "Minutes",
      "UUID": "com.lvercauteren.datecountdown.minutes",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "Encoder": {
        "layout": "countdown.json"
      },
      "States": [
        {
          "Image": "imgs/action"
        }
      ]
    },
    {
      "Name": "Seconds",
